# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- node / build ----
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
coverage/
.npm/

# ---- runtime state (regenerated by api/store.py + api/seed.py) ----
# data/ is derived: the store self-seeds deterministically on first boot, so the repo
# carries no demo state and a checkout can never start from a mutated database.
data/

# ---- os / editor ----
.DS_Store
*.swp
.idea/
.vscode/

# ---- secrets: never commit these, even locally ----
.env
.env.*
!*.env.example
*.pem
*.key
